{
  "name": "aproxima-2026-totems",
  "version": "0.2.0",
  "description": "Totens interativos do evento APROXIMA 2026 - FIPECq Previdencia (Jogo das Transformacoes, Concurso Cultural e Votacao)",
  "main": "main.js",
  "author": "FIPECq Previdencia",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:kiosk": "electron . --kiosk",
    "start:transformations": "electron . --totem-mode=transformations",
    "start:contest": "electron . --totem-mode=contest",
    "start:voting": "electron . --totem-mode=voting",
    "build:win": "electron-builder --win",
    "build:win:totens": "node scripts/build-totem.js transformations voting",
    "build:win:transformations":"node scripts/build-totem.js transformations",
    "build:win:contest": "node scripts/build-totem.js contest",
    "build:win:voting": "node scripts/build-totem.js voting"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "br.org.fipecq.aproxima2026.totens",
    "productName": "Aproxima 2026 Totens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!database/*.sqlite",
      "!database/*.sqlite3",
      "!content/**",
      "!scripts/**",
      "!build/**",
      "!dist/**",
      "!*.pdf",
      "!*.docx"
    ],
    "extraResources": [
      {
        "from": "config/app-config.json",
        "to": "app-config.json"
      },
      {
        "from": "content",
        "to": "content"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
