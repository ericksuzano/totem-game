{
  "name": "aproxima-2026-totems",
  "version": "0.1.0",
  "description": "Totens interativos do evento APROXIMA 2026 - FIPECq Previdencia (Jogo das Transformacoes e Votacao)",
  "main": "main.js",
  "author": "FIPECq Previdencia",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:kiosk": "electron . --kiosk",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "br.org.fipecq.aproxima2026.totens",
    "productName": "Aproxima 2026 Totens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!database/*.sqlite",
      "!database/*.sqlite3"
    ],
    "extraResources": [
      {
        "from": "config/app-config.json",
        "to": "app-config.json"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
